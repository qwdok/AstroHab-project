# AstroHab configuration. Copy this file to .env and edit it.
# Real environment variables take priority over this file. Do not commit .env.

# --- Assistant (Gemini) ---
# One key, or several separated by commas (the next key is used when one runs out of quota).
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.6-flash
# Optional backup model if the main one stays busy:
GEMINI_FALLBACK_MODEL=
# Milliseconds to wait for Gemini before the offline (local) assistant answers instead:
GEMINI_TIMEOUT_MS=15000

# --- Web server ---
# Long random text that signs login sessions. Without it, everyone is signed out on each restart.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# 127.0.0.1 = this computer only. 0.0.0.0 = reachable from phones on the same network.
HOST=127.0.0.1
PORT=5000
# Extra HTTPS port (needed for the microphone from a phone).
HTTPS_ENABLED=true
HTTPS_PORT=5443

# --- Accounts ---
# Optional invite code required to create accounts after the admin. Leave empty for open registration.
REGISTRATION_CODE=
# The first (admin) account is only allowed from this computer. Set true only if every request looks
# remote to the app (for example inside Docker).
ALLOW_REMOTE_FIRST_ADMIN=false

# --- Hardware and voice ---
SERIAL_ENABLED=true
# COM7 on Windows (check Device Manager); on Linux usually /dev/ttyUSB0, on macOS /dev/cu.usbserial-xxxx
SERIAL_PORT=COM7
VOICE_ENABLED=true
# Spoken alerts / automatic assistant replies from the host speaker. Off by default: they appear in the chat only.
# Assistant replies to a user's own question are always spoken in that user's browser (phone or laptop), never from the host speaker.
SPEAK_AUTO=false
